{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mdread",
  "version": "0.0.6",
  "identifier": "app.mdread.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "mdread", "width": 1280, "height": 850, "minWidth": 800, "minHeight": 600, "center": true }
    ],
    "appDirectoriesOverride": { "localData": "data" },
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "category": "Productivity",
    "shortDescription": "A quiet reading room for Markdown",
    "longDescription": "A local-first Markdown reader and editor.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
