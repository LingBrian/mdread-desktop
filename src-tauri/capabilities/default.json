{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "mdread desktop main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-read-dir",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-copy-file",
    "fs:allow-rename",
    "fs:allow-remove"
  ]
}
