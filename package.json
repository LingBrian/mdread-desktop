{
  "name": "mdread-desktop",
  "version": "0.0.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.js --host 127.0.0.1",
    "build": "vite build --config vite.config.js",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "portable:build": "node node_modules/@tauri-apps/cli/tauri.js build --no-bundle --target x86_64-pc-windows-msvc",
    "test": "vitest run --config vitest.config.js --configLoader runner",
    "test:app": "vitest run --config vitest.app.config.js --configLoader runner"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.0",
    "dompurify": "^3.4.7",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.4",
    "y-codemirror.next": "^0.3.6",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "sass": "^1.100.0",
    "sass-embedded": "^1.107.1",
    "vite": "^8.0.14",
    "vitest": "^3.2.7"
  }
